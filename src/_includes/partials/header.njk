<!-- ===================== MOBILE MENU ===================== -->
<div class="mobile-menu" id="mobileMenu">
  <button class="mobile-menu-close" onclick="closeMobileMenu()">✕</button>
  {% for link in site.navLinks %}
  <a href="{{ link.href }}" onclick="closeMobileMenu()">{{ link.label }}</a>
  {% endfor %}
  <div class="mobile-cta-btn">💬 LINEで無料相談</div>
</div>

<!-- ===================== HEADER ===================== -->
<header id="site-header">
  <div class="header-inner">
    <a class="logo" href="/" aria-label="トップページへ戻る">
      <div class="logo-img-wrap">
        <img src="/images/logo.jpg" alt="遥か行政書士事務所ロゴ" width="48" height="48" loading="eager" style="width:100%;height:100%;object-fit:contain;border-radius:0;">
      </div>
      <span class="logo-text">
        遥か行政書士事務所
        <span class="logo-sub">HARUKA LEGAL SUPPORT</span>
      </span>
    </a>
    <div class="header-cta-wrap">
      <a href="{{ site.lineUrl }}" class="header-cta" target="_blank" rel="noopener" aria-label="LINE相談">
        LINEで無料相談
        <span class="header-cta-sub">24時間受付</span>
      </a>
      <a href="/#contact" class="header-cta header-cta-form" aria-label="フォーム相談">
        フォームで相談
        <span class="header-cta-sub">お問い合わせ無料</span>
      </a>
    </div>
    <button class="hamburger" onclick="openMobileMenu()" aria-label="メニューを開く">
      <span></span><span></span><span></span>
    </button>
  </div>
  <nav>
    <div class="nav-inner">
      <div style="display:flex;align-items:center;gap:6px;flex-wrap:wrap">
        <span class="nav-badge">開業準備中</span>
        <div class="nav-links">
          {% for link in site.navLinks %}
          <a href="{{ link.href }}"{% if link.key == navActive %} class="active"{% endif %}>{{ link.label }}</a>
          {% endfor %}
        </div>
      </div>
      <div class="nav-addr">
        <svg viewBox="0 0 24 24"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7z"/><circle cx="12" cy="9" r="2.5"/></svg>
        {{ site.address }}
      </div>
    </div>
  </nav>
</header>
