{% set t = fo[lang] %}
<section id="faq" class="home-faq">
  <div class="home-sec-inner">
    <div class="sec-eyebrow">{{ t.faqEyebrow }}</div>
    <h2 class="sec-title">{{ t.faqTitle | safe }}</h2>
    <div class="faq-list">
      {% for item in t.faq %}
      <details class="faq-item">
        <summary>{{ item.q }}</summary>
        <p>{{ item.a | safe }}</p>
      </details>
      {% endfor %}
    </div>
  </div>
</section>
<section id="office" class="home-office">
  <div class="home-sec-inner">
    <div class="sec-eyebrow">{{ t.offEyebrow }}</div>
    <h2 class="sec-title">{{ t.offTitle | safe }}</h2>
    <dl class="office-table">
      {% for row in t.office %}
      <dt>{{ row[0] }}</dt><dd>{{ row[1] | safe }}</dd>
      {% endfor %}
    </dl>
  </div>
</section>
