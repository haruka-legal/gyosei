<!DOCTYPE html>
<html lang="{{ lang }}">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title }}</title>
<meta name="description" content="{{ description }}">
<link rel="canonical" href="{{ site.url }}{{ page.url | url }}">
{% if altUrls %}
{% if altUrls.en %}<link rel="alternate" hreflang="en" href="{{ site.url }}{{ altUrls.en | url }}">{% endif %}
{% if altUrls.es %}<link rel="alternate" hreflang="es" href="{{ site.url }}{{ altUrls.es | url }}">{% endif %}
{% if altUrls.ja %}<link rel="alternate" hreflang="ja" href="{{ site.url }}{{ altUrls.ja | url }}">{% endif %}
{% if altUrls.en and (altUrls.es or altUrls.ja) %}<link rel="alternate" hreflang="x-default" href="{{ site.url }}{{ altUrls.en | url }}">{% endif %}
{% endif %}
<meta property="og:type" content="{% if isGuide %}article{% else %}website{% endif %}">
<meta property="og:title" content="{{ title }}">
<meta property="og:description" content="{{ description }}">
<meta property="og:url" content="{{ site.url }}{{ page.url | url }}">
<meta property="og:site_name" content="{{ site.brandName }}">
<meta property="og:locale" content="{% if lang == 'en' %}en_US{% elif lang == 'es' %}es_ES{% else %}ja_JP{% endif %}">
<meta name="twitter:card" content="summary_large_image">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,400&family=Plus+Jakarta+Sans:wght@300;400;500;600&family=Noto+Sans+JP:wght@300;400;500&display=swap" rel="stylesheet">
<link rel="stylesheet" href="{{ '/assets/style.css' | url }}?v={{ build.v }}">
<link rel="stylesheet" href="{{ '/assets/site-extra.css' | url }}?v={{ build.v }}">
<link rel="icon" href="{{ '/assets/images/logo.jpg' | url }}">
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "LegalService",
  "name": "{{ site.brandName }}",
  "alternateName": "{{ site.brandNameJa }}",
  "url": "{{ site.url }}{{ '/' | url }}",
  "description": {{ description | dump | safe }},
  "areaServed": "JP",
  "priceRange": "¥¥",
  "address": { "@type": "PostalAddress", "streetAddress": "神田錦町3-6-4", "addressLocality": "千代田区", "addressRegion": "東京都", "postalCode": "101-0054", "addressCountry": "JP" },
  "founder": { "@type": "Person", "name": "Haruka Kishi", "alternateName": "岸 はるか", "jobTitle": "Gyoseishoshi Lawyer (行政書士)", "sameAs": ["https://www.linkedin.com/in/haruka-kishi"] }
}
</script>
{% block head %}{% endblock %}
</head>
<body>
<header>
<div class="header-inner">
<a class="logo" href="{{ (('/' if lang == 'en' else ('/es/' if lang == 'es' else '/ja/'))) | url }}">
<img alt="{{ site.brandName }}" src="{{ '/assets/images/logo.jpg' | url }}">
<div class="logo-name">
{{ site.brandName }}
<small>Visa &amp; Immigration Support · Tokyo</small>
</div>
</a>
<div class="hdr-right">
<div class="hdr-ctas">
{% if lang == 'en' %}
<a class="hdr-cta hdr-cta-wa" href="https://wa.me/haruka.legal?text=Hello%2C%20I%20would%20like%20to%20consult%20about%20my%20visa." rel="noopener" target="_blank">WhatsApp</a>
<a class="hdr-cta hdr-cta-form" href="{{ '/#info' | url }}">Contact form</a>
{% elif lang == 'es' %}
<a class="hdr-cta hdr-cta-wa" href="https://wa.me/haruka.legal?text=Hola%2C%20quisiera%20consultar%20sobre%20mi%20visa." rel="noopener" target="_blank">WhatsApp</a>
<a class="hdr-cta hdr-cta-form" href="{{ '/es/#info' | url }}">Formulario</a>
{% elif lang == 'ja' %}
<a class="hdr-cta hdr-cta-wa" href="https://wa.me/haruka.legal?text=%E3%81%93%E3%82%93%E3%81%AB%E3%81%A1%E3%81%AF%E3%80%82%E3%83%93%E3%82%B6%E3%81%AB%E3%81%A4%E3%81%84%E3%81%A6%E7%9B%B8%E8%AB%87%E3%81%97%E3%81%9F%E3%81%84%E3%81%A7%E3%81%99%E3%80%82" rel="noopener" target="_blank">WhatsApp</a>
<a class="hdr-cta hdr-cta-form" href="{{ '/ja/#info' | url }}">フォームで相談</a>
{% endif %}
</div>
<div class="lang-switch">
<button type="button" class="lang-toggle" aria-haspopup="true" aria-expanded="false" aria-label="{% if lang == 'en' %}Language{% elif lang == 'es' %}Idioma{% else %}言語{% endif %}">{% if lang == 'en' %}EN{% elif lang == 'es' %}ES{% else %}JP{% endif %}<span aria-hidden="true">▾</span></button>
<div class="lang-menu">
<a href="{{ ((altUrls.en if (altUrls and altUrls.en) else '/')) | url }}" class="{% if lang == 'en' %}active{% endif %}" lang="en">EN</a>
<a href="{{ ((altUrls.es if (altUrls and altUrls.es) else '/es/')) | url }}" class="{% if lang == 'es' %}active{% endif %}" lang="es">ES</a>
<a href="{{ ((altUrls.ja if (altUrls and altUrls.ja) else '/ja/')) | url }}" class="{% if lang == 'ja' %}active{% endif %}" lang="ja">JP</a>
</div>
</div>
<button aria-label="Menu" class="hamburger" onclick="openMobileNav()"><span></span><span></span><span></span></button>
</div>
</div>
