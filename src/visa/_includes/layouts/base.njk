<!DOCTYPE html>
<html lang="{{ lang }}">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title }}</title>
<meta name="description" content="{{ description }}">
<link rel="canonical" href="{{ site.url }}{{ page.url | url }}">
{% if altUrls %}
{% if altUrls.en %}<link rel="alternate" hreflang="en" href="{{ site.url }}{{ altUrls.en | url }}">{% endif %}
{% if altUrls.es %}<link rel="alternate" hreflang="es" href="{{ site.url }}{{ altUrls.es | url }}">{% endif %}
{% if altUrls.ja %}<link rel="alternate" hreflang="ja" href="{{ site.url }}{{ altUrls.ja | url }}">{% endif %}
{% if altUrls.en and (altUrls.es or altUrls.ja) %}<link rel="alternate" hreflang="x-default" href="{{ site.url }}{{ altUrls.en | url }}">{% endif %}
{% endif %}
<meta property="og:type" content="{% if isGuide %}article{% else %}website{% endif %}">
<meta property="og:title" content="{{ title }}">
<meta property="og:description" content="{{ description }}">
<meta property="og:url" content="{{ site.url }}{{ page.url | url }}">
<meta property="og:site_name" content="{{ site.brandName }}">
<meta property="og:locale" content="{% if lang == 'en' %}en_US{% elif lang == 'es' %}es_ES{% else %}ja_JP{% endif %}">
<meta name="twitter:card" content="summary_large_image">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,400&family=Plus+Jakarta+Sans:wght@300;400;500;600&family=Noto+Sans+JP:wght@300;400;500&display=swap" rel="stylesheet">
<link rel="stylesheet" href="{{ '/assets/style.css' | url }}">
<link rel="stylesheet" href="{{ '/assets/site-extra.css' | url }}">
<link rel="icon" href="{{ '/assets/images/logo.jpg' | url }}">
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "LegalService",
  "name": "{{ site.brandName }}",
  "alternateName": "{{ site.brandNameJa }}",
  "url": "{{ site.url }}{{ '/' | url }}",
  "description": {{ description | dump | safe }},
  "areaServed": "JP",
  "priceRange": "¥¥",
  "address": { "@type": "PostalAddress", "streetAddress": "神田錦町3-6-4", "addressLocality": "千代田区", "addressRegion": "東京都", "postalCode": "101-0054", "addressCountry": "JP" },
  "founder": { "@type": "Person", "name": "Haruka Kishi", "alternateName": "岸 はるか", "jobTitle": "Gyoseishoshi Lawyer (行政書士)", "sameAs": ["https://www.linkedin.com/in/haruka-kishi"] }
}
</script>
{% block head %}{% endblock %}
</head>
<body>
<header>
<div class="header-inner">
<a class="logo" href="{{ (('/' if lang == 'en' else ('/es/' if lang == 'es' else '/ja/'))) | url }}">
<img alt="{{ site.brandName }}" src="{{ '/assets/images/logo.jpg' | url }}">
<div class="logo-name">
{{ site.brandName }}
<small>Visa &amp; Immigration Support · Tokyo</small>
</div>
</a>
<div class="hdr-right">
<div class="hdr-ctas">
{% if lang == 'en' %}
<a class="hdr-cta hdr-cta-wa" href="https://wa.me/819038581198" rel="noopener" target="_blank">WhatsApp</a>
<a class="hdr-cta hdr-cta-form" href="{{ '/#info' | url }}">Contact form</a>
{% elif lang == 'es' %}
<a class="hdr-cta hdr-cta-wa" href="https://wa.me/819038581198" rel="noopener" target="_blank">WhatsApp</a>
<a class="hdr-cta hdr-cta-form" href="{{ '/es/#info' | url }}">Formulario</a>
{% elif lang == 'ja' %}
<a class="hdr-cta hdr-cta-wa" href="https://wa.me/819038581198" rel="noopener" target="_blank">WhatsApp</a>
<a class="hdr-cta hdr-cta-form" href="{{ '/ja/#info' | url }}">フォームで相談</a>
{% endif %}
</div>
<div class="lang-switch">
<button type="button" class="lang-toggle" aria-haspopup="true" aria-expanded="false" aria-label="{% if lang == 'en' %}Language{% elif lang == 'es' %}Idioma{% else %}言語{% endif %}">{% if lang == 'en' %}EN{% elif lang == 'es' %}ES{% else %}JP{% endif %}<span aria-hidden="true">▾</span></button>
<div class="lang-menu">
<a href="{{ ((altUrls.en if (altUrls and altUrls.en) else '/')) | url }}" class="{% if lang == 'en' %}active{% endif %}" lang="en">EN</a>
<a href="{{ ((altUrls.es if (altUrls and altUrls.es) else '/es/')) | url }}" class="{% if lang == 'es' %}active{% endif %}" lang="es">ES</a>
<a href="{{ ((altUrls.ja if (altUrls and altUrls.ja) else '/ja/')) | url }}" class="{% if lang == 'ja' %}active{% endif %}" lang="ja">JP</a>
</div>
</div>
</div>
</div>
<nav class="main-nav" aria-label="Menu">
<ul class="main-nav-list">
{% if lang == 'en' %}
  <li><a href="{{ '/' | url }}">Home</a></li>
  <li><a href="{{ '/#cases' | url }}">Services</a></li>
  <li class="has-sub"><a href="{{ '/gyoseishoshi/' | url }}" aria-haspopup="true">What Is a Gyoseishoshi?</a>
    <ul class="sub">
      <li><a href="{{ '/gyoseishoshi/#how-to-choose' | url }}">How to Choose a Gyoseishoshi</a></li>
      <li><a href="{{ '/gyoseishoshi/#benefits' | url }}">Benefits and Limitations</a></li>
      <li><a href="{{ '/why-choose-us/' | url }}">Why Choose Us</a></li>
    </ul>
  </li>
  <li><a href="{{ '/#fees' | url }}">Fees</a></li>
  <li><a href="{{ '/guides/' | url }}">Guides</a></li>
  <li><a href="{{ '/#profile' | url }}">Message from the Founder</a></li>
  <li><a href="{{ '/#faq' | url }}">FAQ</a></li>
  <li><a href="{{ '/#office' | url }}">Our Office</a></li>
  <li><a href="{{ '/#info' | url }}">Contact</a></li>
{% elif lang == 'es' %}
  <li><a href="{{ '/es/' | url }}">Inicio</a></li>
  <li><a href="{{ '/es/#cases' | url }}">Servicios</a></li>
  <li class="has-sub"><a href="{{ '/es/gyoseishoshi/' | url }}" aria-haspopup="true">¿Qué es un gyoseishoshi?</a>
    <ul class="sub">
      <li><a href="{{ '/es/gyoseishoshi/#how-to-choose' | url }}">Cómo elegir un gyoseishoshi</a></li>
      <li><a href="{{ '/es/gyoseishoshi/#benefits' | url }}">Ventajas y limitaciones</a></li>
      <li><a href="{{ '/es/why-choose-us/' | url }}">Por qué elegirnos</a></li>
    </ul>
  </li>
  <li><a href="{{ '/es/#fees' | url }}">Honorarios</a></li>
  <li><a href="{{ '/es/guides/' | url }}">Guías</a></li>
  <li><a href="{{ '/es/#profile' | url }}">Mensaje de la Fundadora</a></li>
  <li><a href="{{ '/es/#faq' | url }}">Preguntas frecuentes</a></li>
  <li><a href="{{ '/es/#office' | url }}">Nuestra oficina</a></li>
  <li><a href="{{ '/es/#info' | url }}">Contacto</a></li>
{% elif lang == 'ja' %}
  <li><a href="{{ '/ja/' | url }}">トップ</a></li>
  <li><a href="{{ '/ja/#cases' | url }}">業務内容</a></li>
  <li class="has-sub"><a href="{{ '/ja/gyoseishoshi/' | url }}" aria-haspopup="true">行政書士とは</a>
    <ul class="sub">
      <li><a href="{{ '/ja/gyoseishoshi/#how-to-choose' | url }}">行政書士の選び方</a></li>
      <li><a href="{{ '/ja/gyoseishoshi/#benefits' | url }}">依頼するメリット・デメリット</a></li>
      <li><a href="{{ '/ja/why-choose-us/' | url }}">当事務所が選ばれる理由</a></li>
    </ul>
  </li>
  <li><a href="{{ '/ja/#fees' | url }}">料金</a></li>
  <li><a href="{{ '/ja/guides/' | url }}">お役立ち記事</a></li>
  <li><a href="{{ '/ja/#profile' | url }}">代表挨拶</a></li>
  <li><a href="{{ '/ja/#faq' | url }}">よくある質問</a></li>
  <li><a href="{{ '/ja/#office' | url }}">事務所案内</a></li>
  <li><a href="{{ '/ja/#info' | url }}">お問い合わせ</a></li>
{% endif %}
</ul>
</nav>
</header>
<div class="float-ctas">
{% if lang == 'en' %}
<a class="hdr-cta hdr-cta-wa" href="https://wa.me/819038581198" rel="noopener" target="_blank">WhatsApp</a>
<a class="hdr-cta hdr-cta-form" href="{{ '/#info' | url }}">Contact form</a>
{% elif lang == 'es' %}
<a class="hdr-cta hdr-cta-wa" href="https://wa.me/819038581198" rel="noopener" target="_blank">WhatsApp</a>
<a class="hdr-cta hdr-cta-form" href="{{ '/es/#info' | url }}">Formulario</a>
{% elif lang == 'ja' %}
<a class="hdr-cta hdr-cta-wa" href="https://wa.me/819038581198" rel="noopener" target="_blank">WhatsApp</a>
<a class="hdr-cta hdr-cta-form" href="{{ '/ja/#info' | url }}">フォームで相談</a>
{% endif %}
</div>


{% if site.notice[lang] %}
<div class="site-notice" role="status"><div class="wrap">{{ site.notice[lang] }}</div></div>
{% endif %}

<main id="main">
{{ content | safe }}
</main>

<footer>
<div class="foot-inner">
<div style="display:flex;flex-direction:column;gap:6px;">
<div>&copy; 2026 {{ site.brandName }} · {{ site.brandNameJa }}</div>
<div><a href="https://haruka-legal.com/privacy/{% if lang == 'ja' %}{% else %}en/{% endif %}" style="color:rgba(255,255,255,.55);font-size:11px;">{% if lang == 'en' %}Privacy Policy{% elif lang == 'es' %}Política de privacidad (inglés){% else %}プライバシーポリシー{% endif %}</a></div>
<div style="display:flex;align-items:center;gap:6px;color:rgba(255,255,255,.45);">
<span>{{ site.author.location }}</span>
</div>
<div style="margin-top:4px;">
<a href="https://haruka-legal.com/gyosei/" rel="noopener" target="_blank" style="color:rgba(255,255,255,.4);font-size:11px;">
{% if lang == 'en' %}Japanese site (日本語版){% elif lang == 'es' %}Sitio en japonés (日本語版){% else %}日本語版サイトはこちら{% endif %}
</a>
</div>
</div>
<div style="display:flex;align-items:center;gap:16px;">
<a href="https://haruka-legal.com" style="color:rgba(255,255,255,.3);">haruka-legal.com</a>
</div>
</div>
</footer>
<script src="{{ '/assets/main.js' | url }}"></script>
</body>
</html>
