---
layout: layouts/base.njk
title: "相続・遺言のお役立ち記事一覧"
description: "相続の手続きや遺言書について、はじめての方にもわかりやすく解説した記事の一覧です。"
permalink: /articles/
navActive: articles
---
<script type="application/ld+json">
{"@context":"https://schema.org","@type":"CollectionPage","name":{{ title | dump | safe }},"description":{{ description | dump | safe }},"url":"{{ site.url }}/articles/","inLanguage":"ja","isPartOf":{"@type":"WebSite","name":"遥か行政書士事務所","url":"{{ site.url }}/"},"mainEntity":{"@type":"ItemList","numberOfItems":{{ collections.articles.length }},"itemListElement":[{% for article in collections.articles %}{"@type":"ListItem","position":{{ loop.index }},"url":"{{ site.url }}{{ article.url }}","name":{{ article.data.title | dump | safe }}}{% if not loop.last %},{% endif %}{% endfor %}]}}
</script>
<script type="application/ld+json">
{"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"トップ","item":"{{ site.url }}/"},{"@type":"ListItem","position":2,"name":"お役立ち記事一覧","item":"{{ site.url }}/articles/"}]}
</script>

{% set root = page.url | relRoot %}
<div class="article-hero">
  <div class="container">
    <div class="breadcrumb">
      <a href="{{ root }}">トップ</a> ／ お役立ち記事一覧
    </div>
    <h1 class="article-hero-title">お役立ち記事一覧</h1>
    <div class="article-hero-meta">
      <span>相続の手続きや遺言書について、はじめての方にもわかりやすく解説しています。</span>
    </div>
  </div>
</div>

<div class="services-section" id="articles">
  <div class="container">
    <nav class="chapter-nav" aria-label="章の一覧">
      {% for p in chapters %}
      <div class="chapter-nav-part">
        <p class="chapter-nav-part-title">{{ p.part }}</p>
        <ol class="chapter-nav-list">
          {% for c in p.chapters %}{% set list = collections.articles | chapterArticles(c.slugs) %}
          <li><a href="#ch-{{ c.no }}"><span class="chapter-no">{{ "0" ~ c.no }}</span><span class="chapter-nav-name">{{ c.name }}</span><span class="chapter-nav-count">{{ list.length }}本</span></a></li>
          {% endfor %}
        </ol>
      </div>
      {% endfor %}
    </nav>

    {% for p in chapters %}
    <div class="chapter-part">
      <h2 class="chapter-part-title">{{ p.part }}</h2>
      <p class="chapter-part-lead">{{ p.partLead }}</p>
      {% for c in p.chapters %}{% set list = collections.articles | chapterArticles(c.slugs) %}
      <section class="chapter" id="ch-{{ c.no }}" aria-labelledby="ch-{{ c.no }}-title">
        <h3 class="chapter-title" id="ch-{{ c.no }}-title"><span class="chapter-no">第{{ c.no }}章</span>{{ c.name }}</h3>
        <p class="chapter-lead">{{ c.lead }}</p>
        <ul class="post-list post-list--full">
          {% for article in list %}
          <li class="post-item">
            <a href="{{ root }}{{ article.url | noLeadSlash }}">
              <span class="post-title">{{ article.data.title }}</span>
              {% if article.data.description %}<span class="post-desc">{{ article.data.description }}</span>{% endif %}
            </a>
          </li>
          {% endfor %}
        </ul>
      </section>
      {% endfor %}
    </div>
    {% endfor %}

    {% set rest = collections.articles | unchaptered(chapters) %}
    {% if rest.length %}
    <section class="chapter" id="ch-other">
      <h3 class="chapter-title">そのほかの記事</h3>
      <ul class="post-list post-list--full">
        {% for article in rest %}<li class="post-item"><a href="{{ root }}{{ article.url | noLeadSlash }}"><span class="post-title">{{ article.data.title }}</span></a></li>{% endfor %}
      </ul>
    </section>
    {% endif %}
  </div>
</div>
