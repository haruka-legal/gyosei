<!DOCTYPE html>
<html lang="ja">
<head>
{% set root = page.url | relRoot %}
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ title }}{% if site.name not in title %} | {{ site.name }}{% endif %}</title>

<meta name="description" content="{{ description }}">
{% if keywords %}<meta name="keywords" content="{{ keywords }}">{% endif %}
<meta name="author" content="{{ site.name }}">
<meta name="robots" content="index, follow">
<meta name="theme-color" content="#071832">
<link rel="canonical" href="{{ site.url }}{{ page.url }}">

<meta property="og:type" content="{{ ogType or 'website' }}">
<meta property="og:title" content="{{ title }}">
<meta property="og:description" content="{{ description }}">
<meta property="og:url" content="{{ site.url }}{{ page.url }}">
<meta property="og:site_name" content="{{ site.name }}">
<meta property="og:locale" content="ja_JP">
<meta property="og:image" content="{{ site.url }}{{ ogImage or image or '/images/logo.jpg' }}">

<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ title }}">
<meta name="twitter:description" content="{{ description }}">
<meta name="twitter:image" content="{{ site.url }}{{ ogImage or image or '/images/logo.jpg' }}">

{% if pageType == "article" %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": {{ title | dump | safe }},
  "description": {{ description | dump | safe }},
  "datePublished": "{{ datePublished | isoDate }}",
  "dateModified": "{{ (dateModified or datePublished) | isoDate }}",
  "inLanguage": "ja",
  "url": "{{ site.url }}{{ page.url }}",
  "author": { "@type": "Person", "name": "{{ site.representative.name }}", "jobTitle": "{{ site.representative.jobTitle }}", "url": "{{ site.url }}/#profile", "worksFor": { "@type": "LegalService", "name": "{{ site.name }}" } },
  "publisher": {
    "@type": "LegalService",
    "name": "{{ site.name }}",
    "logo": { "@type": "ImageObject", "url": "{{ site.url }}{{ site.logo }}" }
  },
  "mainEntityOfPage": { "@type": "WebPage", "@id": "{{ site.url }}{{ page.url }}" }
}
</script>
{% endif %}

{% if page.url == "/" %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "LegalService",
  "@id": "{{ site.url }}/#office",
  "name": "{{ site.name }}",
  "alternateName": "{{ site.nameEn }}",
  "url": "{{ site.url }}/",
  "logo": "{{ site.url }}{{ site.logo }}",
  "image": "{{ site.url }}{{ site.logo }}",
  "description": {{ description | dump | safe }},
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "{{ site.addressStreet }}",
    "addressLocality": "千代田区",
    "addressRegion": "東京都",
    "postalCode": "{{ site.postalCode }}",
    "addressCountry": "JP"
  },
  "areaServed": [{ "@type": "City", "name": "千代田区" }, { "@type": "AdministrativeArea", "name": "東京都" }, { "@type": "Country", "name": "日本" }],
  "knowsAbout": {{ site.knowsAbout | dump | safe }},
  "contactPoint": { "@type": "ContactPoint", "contactType": "customer service", "url": "{{ site.lineUrl }}", "availableLanguage": ["ja"] },
  "founder": { "@id": "{{ site.url }}/#representative" },
  "employee": { "@id": "{{ site.url }}/#representative" }
}
</script>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Person",
  "@id": "{{ site.url }}/#representative",
  "name": "{{ site.representative.name }}",
  "jobTitle": "{{ site.representative.jobTitle }}",
  "worksFor": { "@id": "{{ site.url }}/#office" },
  "image": "{{ site.url }}/images/profile_main.jpg",
  "url": "{{ site.url }}/#profile"{% if site.representative.sameAs %},
  "sameAs": {{ site.representative.sameAs | dump | safe }}{% endif %}
}
</script>
{% endif %}

{% if breadcrumbs %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {% for crumb in breadcrumbs %}
    { "@type": "ListItem", "position": {{ loop.index }}, "name": {{ crumb.name | dump | safe }}, "item": "{{ site.url }}{{ crumb.url }}" }{% if not loop.last %},{% endif %}
    {% endfor %}
  ]
}
</script>
{% endif %}

{% if faq %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {% for item in faq %}
    {
      "@type": "Question",
      "name": {{ item.q | dump | safe }},
      "acceptedAnswer": { "@type": "Answer", "text": {{ item.a | dump | safe }} }
    }{% if not loop.last %},{% endif %}
    {% endfor %}
  ]
}
</script>
{% endif %}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Noto+Serif+JP:wght@300;400;600&family=Noto+Sans+JP:wght@300;400;500;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="{{ root }}css/style.css">
</head>
<body id="top">

{% include "partials/header.njk" %}

{{ content | safe }}

{% include "partials/footer.njk" %}
</body>
</html>
