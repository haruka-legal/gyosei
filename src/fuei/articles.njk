---
layout: layouts/base.njk
title: "風俗営業許可・夜のお店のお役立ち記事一覧"
description: "風俗営業の許可や深夜酒類提供飲食店営業の届出について、開業を考えている方に向けた記事を、開業の段階と業種・テーマごとにまとめています。"
permalink: /articles/
navActive: articles
---
<script type="application/ld+json">
{"@context":"https://schema.org","@type":"CollectionPage","name":{{ title | dump | safe }},"description":{{ description | dump | safe }},"url":"{{ site.url }}/articles/","inLanguage":"ja","isPartOf":{"@type":"WebSite","name":"遥か行政書士事務所","url":"{{ site.url }}/"},"mainEntity":{"@type":"ItemList","numberOfItems":{{ collections.articles.length }},"itemListElement":[{% for article in collections.articles %}{"@type":"ListItem","position":{{ loop.index }},"url":"{{ site.url }}{{ article.url }}","name":{{ article.data.title | dump | safe }}}{% if not loop.last %},{% endif %}{% endfor %}]}}
</script>
<script type="application/ld+json">
{"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"トップ","item":"{{ site.url }}/"},{"@type":"ListItem","position":2,"name":"お役立ち記事一覧","item":"{{ site.url }}/articles/"}]}
</script>

{% set root = page.url | relRoot %}
<div class="article-hero">
  <div class="container">
    <div class="breadcrumb">
      <a href="{{ root }}">トップ</a> ／ お役立ち記事一覧
    </div>
    <h1 class="article-hero-title">お役立ち記事一覧</h1>
    <div class="article-hero-meta">
      <span>お店の開業に必要な許可や届出、営業を始めてからの手続きを、段階と業種・テーマごとにまとめています。</span>
    </div>
  </div>
</div>

<div class="services-section" id="articles">
  <div class="container">
    <div class="post-filter" role="group" aria-label="章で絞り込む">
      <button type="button" class="post-filter-btn" data-cat="all" aria-pressed="true">すべて<span class="post-filter-count">{{ collections.articles.length }}</span></button>
      {% for g in chapters.groups %}{% for ch in g.chapters %}{% set n = collections.articles | filterByCat(ch.cat) | length %}{% if n %}<button type="button" class="post-filter-btn" data-cat="{{ ch.cat }}" aria-pressed="false">{{ ch.cat }}<span class="post-filter-count">{{ n }}</span></button>{% endif %}{% endfor %}{% endfor %}
    </div>
    {% set no = 0 %}
    {% for g in chapters.groups %}
    <div class="chapter-group">
      <h2 class="chapter-group-title">{{ g.name }}</h2>
      {% for ch in g.chapters %}
      {% set list = collections.articles | filterByCat(ch.cat) %}
      {% if list.length %}
      {% if ch.cat != "コラム" %}{% set no = no + 1 %}{% endif %}
      <section class="chapter" data-cat="{{ ch.cat }}">
        <h3 class="chapter-title">{% if ch.cat != "コラム" %}<span class="chapter-no">第{{ no }}章</span>{% endif %}{{ ch.title }}</h3>
        <ul class="post-list post-list--full">
          {% for article in list %}
          <li class="post-item">
            <a href="{{ root }}{{ article.url | noLeadSlash }}">
              <span class="post-meta"><time datetime="{{ article.data.datePublished | isoDate }}">{{ article.data.datePublished | cardDate }}</time></span>
              <span class="post-title">{{ article.data.title }}</span>
            </a>
          </li>
          {% endfor %}
        </ul>
      </section>
      {% endif %}
      {% endfor %}
    </div>
    {% endfor %}
  </div>
</div>

<script>
(function(){
  var btns = document.querySelectorAll('.post-filter-btn');
  if (!btns.length) return;
  var secs = document.querySelectorAll('.chapter');
  var groups = document.querySelectorAll('.chapter-group');
  function apply(cat){
    btns.forEach(function(b){ b.setAttribute('aria-pressed', b.dataset.cat === cat ? 'true' : 'false'); });
    secs.forEach(function(s){ s.hidden = !(cat === 'all' || s.dataset.cat === cat); });
    groups.forEach(function(g){ g.hidden = !g.querySelector('.chapter:not([hidden])'); });
  }
  btns.forEach(function(b){ b.addEventListener('click', function(){
    apply(b.dataset.cat);
    try { history.replaceState(null, '', b.dataset.cat === 'all' ? location.pathname : '#' + encodeURIComponent(b.dataset.cat)); } catch(e) {}
  }); });
  var h = decodeURIComponent(location.hash.slice(1));
  if (h) { var ok = Array.prototype.some.call(btns, function(b){ return b.dataset.cat === h; }); if (ok) apply(h); }
})();
</script>
