          <svg width="18" height="18" viewBox="0 0 24 24" style="fill:currentColor;stroke:none"><path d="M12 2C6.48 2 2 5.92 2 10.72c0 3.1 1.7 5.84 4.3 7.52l-.7 2.62 2.92-1.44c1.1.3 2.27.46 3.48.46 5.52 0 10-3.92 10-8.72S17.52 2 12 2z"/></svg>
